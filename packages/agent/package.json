{
  "name": "@ironflow/agent",
  "version": "0.55.0",
  "description": "Ironflow agent for ACP editors (Zed, JetBrains): writes Ironflow application code",
  "type": "module",
  "bin": { "ironflow-agent": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && node scripts/copy-skills.mjs",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@flue/runtime": "2.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": { "node": ">=22.19.0" },
  "license": "LicenseRef-Ironflow-EULA",
  "homepage": "https://ironflow.run",
  "bugs": {
    "url": "https://github.com/sahina/ironflow-issues/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahina/ironflow-js.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public"
  }
}
