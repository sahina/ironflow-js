{
  "name": "@ironflow/node",
  "version": "0.55.0",
  "description": "Node.js SDK for Ironflow event-driven backend platform - workers, serve handlers, and step execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js",
      "default": "./dist/serve.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./worker-streaming": {
      "types": "./dist/worker-streaming.d.ts",
      "import": "./dist/worker-streaming.js",
      "default": "./dist/worker-streaming.js"
    },
    "./consumer-group-stream": {
      "types": "./dist/consumer-group-stream.d.ts",
      "import": "./dist/consumer-group-stream.js",
      "default": "./dist/consumer-group-stream.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js",
      "default": "./dist/test/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "default": "./dist/agent/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc --build tsconfig.build.json",
    "build:bundle": "node scripts/sync-version.mjs && tsc --build tsconfig.build.json && node scripts/bundle.mjs",
    "predev": "node scripts/sync-version.mjs",
    "dev": "tsc --build tsconfig.build.json --watch",
    "pretest": "node scripts/sync-version.mjs",
    "test": "pnpm typecheck && vitest run && pnpm test:logging-package",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 src/",
    "clean": "rm -rf dist dist-bundle tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.json --noEmit",
    "pack:local": "pnpm build:bundle && cd dist-bundle && pnpm pack --pack-destination /tmp/ironflow-packs",
    "test:without-otel": "pnpm build:bundle && node scripts/test-without-otel.mjs",
    "test:logging-package": "pnpm build:bundle && node scripts/test-without-otel.mjs && node scripts/test-logging-package.mjs"
  },
  "dependencies": {
    "@ironflow/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ironflow",
    "workflow",
    "serverless",
    "worker",
    "step-functions"
  ],
  "author": "Ironflow",
  "license": "LicenseRef-Ironflow-EULA",
  "homepage": "https://ironflow.run",
  "bugs": {
    "url": "https://github.com/sahina/ironflow-issues/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahina/ironflow-js.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  }
}
